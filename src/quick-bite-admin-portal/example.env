VITE_API_GATEWAY_URL=http://localhost:3001
VITE_IDENTITY_SERVICE_URL=http://localhost:44391
VITE_OIDC_CLIENT_ID=QuickBite_Portal
VITE_OIDC_SCOPE=openid profile email roles QuickBite_Gateway

# Direct service URLs for cold-start wakeup ping (bypassing Gateway)
VITE_IDENTITY_URL=example.com
VITE_ORDER_URL=example.com
VITE_CATALOG_URL=example.com
VITE_INVENTORY_URL=example.com
VITE_PAYMENT_URL=example.com

# System Maintenance & Operating Hours (UTC+7)
# Set VITE_IS_MAINTAIN to "true" to lock portal in maintenance mode
VITE_IS_MAINTAIN=false
# Operating window in HH:mm (24-hour UTC+7 format). Leave blank for 24/7 operation.
VITE_STARTUP=08:00
VITE_SHUTDOWN=22:00
