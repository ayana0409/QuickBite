@page "/accounts/edit/{id:guid}"
@model QuickBite.Identity.Web.Pages.Accounts.EditModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Edit Account</h2>
    <a href="/accounts" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i>Back to Accounts
    </a>
</div>

<!-- INFORMATION -->

<abp-card class="mb-4">

    <abp-card-header>
        Account Information
    </abp-card-header>

    <abp-card-body>

        <form method="post"
              asp-page-handler="Information">

            <input type="hidden" asp-for="Id" />

            <abp-input asp-for="Information.UserName" />

            <abp-input asp-for="Information.Name" />

            <abp-input asp-for="Information.Surname" />

            <abp-input asp-for="Information.Email" />

            <abp-input asp-for="Information.PhoneNumber" />
            <abp-input asp-for="Information.IsActive" />
            <abp-input asp-for="Information.LockoutEnabled" />  
            <div class="mt-3">

                <abp-button button-type="Primary"
                            type="submit">

                    Save Information

                </abp-button>

            </div>

        </form>

    </abp-card-body>

</abp-card>



<!-- ROLES -->

<abp-card class="mb-4">

    <abp-card-header>
        Roles
    </abp-card-header>

    <abp-card-body>

        <form method="post"
              asp-page-handler="Roles">

            <input type="hidden"
                   asp-for="Id" />

            @if (Model.AllRoles.Any())
            {
                @foreach (var role in Model.AllRoles)
                {
                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               name="SelectedRoles"
                               value="@role.Name"
                               checked="@Model.SelectedRoles.Contains(role.Name)" />

                        <label class="form-check-label">

                            @role.Name

                        </label>

                    </div>
                }
            }
            else
            {
                <p>No roles found.</p>
            }

            <div class="mt-3">

                <abp-button button-type="Primary"
                            type="submit">

                    Save Roles

                </abp-button>

            </div>

        </form>

    </abp-card-body>

</abp-card>

<!-- CHANGE PASSWORD -->
<abp-card class="mb-4">

    <abp-card-header>
        <i class="fa fa-key me-2 text-primary"></i>Change Password
    </abp-card-header>

    <abp-card-body>

        <form method="post"
              asp-page-handler="Password">

            <input type="hidden"
                   asp-for="Id" />

            <div class="mb-3">
                <label asp-for="PasswordInput.NewPassword" class="form-label fw-bold">New Password</label>
                <input asp-for="PasswordInput.NewPassword"
                       class="form-control"
                       type="password"
                       required
                       minlength="6"
                       autocomplete="new-password"
                       placeholder="Enter new password" />
                <span asp-validation-for="PasswordInput.NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PasswordInput.ConfirmPassword" class="form-label fw-bold">Confirm Password</label>
                <input asp-for="PasswordInput.ConfirmPassword"
                       class="form-control"
                       type="password"
                       required
                       minlength="6"
                       autocomplete="new-password"
                       placeholder="Re-enter new password" />
                <span asp-validation-for="PasswordInput.ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mt-3">
                <abp-button button-type="Primary"
                            type="submit">
                    <i class="fa fa-save me-1"></i>Change Password
                </abp-button>
            </div>

        </form>

    </abp-card-body>

</abp-card>