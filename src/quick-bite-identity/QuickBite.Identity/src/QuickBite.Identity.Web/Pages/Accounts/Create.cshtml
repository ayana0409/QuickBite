@page "/accounts/create"
@model CreateModel

<h2>Create Account</h2>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div> 

    <abp-input asp-for="Input.UserName" />
    <abp-input asp-for="Input.Name" />
    <abp-input asp-for="Input.Surname" />
    <abp-input asp-for="Input.Email" />
    <abp-input asp-for="Input.PhoneNumber" />
    <abp-input asp-for="Input.Password" type="password" />
    <abp-checkbox asp-for="Input.IsActive" />

    <!-- ROLES -->
    <abp-card class="mt-4">
        <abp-card-header>Roles</abp-card-header>
        <abp-card-body>
            @if (Model.AllRoles.Any())
            {
                @foreach (var role in Model.AllRoles)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" 
                            name="SelectedRoles" 
                            value="@role.Name" 
                            checked="@Model.SelectedRoles.Contains(role.Name)" />
                        <label class="form-check-label">@role.Name</label>
                    </div>
                }
            }
        </abp-card-body>
    </abp-card>

    <br />
    <abp-button type="submit" button-type="Primary">
        Create
    </abp-button>
</form>
