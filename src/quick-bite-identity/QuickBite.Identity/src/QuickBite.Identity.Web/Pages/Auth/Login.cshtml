@page 
@model QuickBite.Identity.Web.Pages.Auth.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>QuickBite Identity</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

</head>

<body class="bg-light">

    <div class="container vh-100 d-flex justify-content-center align-items-center">

        <div class="card shadow-lg border-0"
             style="width:820px;">

            <div class="card-body p-5">

                
                <div class="card shadow border-0">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <h2 class="fw-bold">QuickBite Identity</h2>

                            <p class="text-muted">
                                Sign in to continue.
                            </p>
                        </div>

                        <form method="post">

                            <!-- Show errors -->
                            @if (!ViewData.ModelState.IsValid)
                            {
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div class="alert alert-danger">
                                        @error.ErrorMessage
                                    </div>
                                }
                            }

                            <abp-input asp-for="LoginInput.UserNameOrEmailAddress"
                                       label="Email or Username" />

                            <abp-input asp-for="LoginInput.Password"
                                       type="password"
                                       label="Password" />

                            <abp-input asp-for="LoginInput.RememberMe" />

                            <div class="d-grid mt-4">
                                <abp-button button-type="Primary"
                                            type="submit"
                                            size="Large">
                                    Login
                                </abp-button>
                            </div>

                        </form>

                        <hr />

                        <div class="text-center">
                            <a asp-page="./ForgotPassword"
                               class="text-decoration-none">
                                Forgot password?
                            </a>
                        </div>

                        <div class="text-center mt-2">

                            Don't have an account?

                            <a asp-page="./Register"
                               class="fw-semibold text-decoration-none">
                                Register
                            </a>

                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

