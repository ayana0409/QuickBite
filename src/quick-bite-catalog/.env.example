DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_DATABASE=mydb
NODE_ENV=development
DB_SSL=true
DB_SSL_CA_PATH="ca.pem"

JWT_SECRET=xxxxxxxxxxxx
JWT_ISSUER=https://localhost:44337
JWT_AUDIENCE=QuickBite

# "true": skip JWT & Permission check for dev local
BYPASS_AUTH=true
KAFKA_BROKER=xxx

# Image Storage Configuration
# STORAGE_PROVIDER: "cloudinary" (default) or "local"
STORAGE_PROVIDER=cloudinary

# Local upload directory path (when STORAGE_PROVIDER=local)
UPLOAD_DIR=uploads

# Cloudinary folder path (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_FOLDER=quick-bite/food-items

# IMAGE_BASE_URL: URL prefix appended dynamically to filenames in GET responses
# For Cloudinary: https://res.cloudinary.com/<your_cloud_name>/image/upload/<CLOUDINARY_FOLDER>/
# For Local: http://localhost:3000/uploads/
IMAGE_BASE_URL=https://res.cloudinary.com/your_cloud_name/image/upload/quick-bite/food-items/

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret