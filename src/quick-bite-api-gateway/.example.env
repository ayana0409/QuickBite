PORT=3000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/quickbite_gateway

# Rate Limiting (in ms and max request count)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Microservice URLs (Fill these in when services are deployed/running)
IDENTITY_URL=http://localhost:44391
ORDER_URL=https://localhost:44386/api/app
CATALOG_URL=http://localhost:3000
INVENTORY_URL=http://localhost:8083/api/v1
PAYMENT_URL=http://localhost:8084/v1

# ==============================================================================
# Request Coalescing Configuration (Deduplicating Concurrent GET Requests)
# ==============================================================================
# COALESCING_ENABLED:
#   - true (default): Groups identical concurrent in-flight GET requests into a single execution.
#   - false: Disables coalescing; every request hits downstream services independently.
COALESCING_ENABLED=true

# COALESCING_EXCLUDE_PATHS:
#   - Comma-separated list of path substrings or patterns to bypass coalescing (e.g. /health,/sse).
#   - Leave empty (default) if all GET endpoints should participate in request coalescing.
COALESCING_EXCLUDE_PATHS=

# COALESCING_ADDITIONAL_HEADERS:
#   - Comma-separated list of extra HTTP header keys to include in the unique coalesce key (e.g. x-tenant-id,x-user-id).
#   - Leave empty (default) to generate key based on [Method + Full URL + Authorization Header].
COALESCING_ADDITIONAL_HEADERS=

