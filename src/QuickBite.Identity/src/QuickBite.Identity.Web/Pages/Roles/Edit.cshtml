@page "/roles/edit/{id:guid}"
@model QuickBite.Identity.Web.Pages.Roles.EditModel

<h2 class="mb-4">Edit Role</h2>

<abp-card>
    <abp-card-header>Edit Role</abp-card-header>
    <abp-card-body>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <abp-input asp-for="Input.Name" />

            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" asp-for="Input.IsDefault" />
                    <label class="form-check-label" asp-for="Input.IsDefault">Is Default Role</label>
                </div>
                <small class="text-muted">Role này sẽ được gán tự động cho user mới.</small>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" asp-for="Input.IsPublic" />
                    <label class="form-check-label" asp-for="Input.IsPublic">Is Public</label>
                </div>
                <small class="text-muted">Người dùng có thể nhìn thấy role này.</small>
            </div>

            <div>
                <abp-button button-type="Primary" type="submit">
                    <i class="fa fa-save"></i> Update Role
                </abp-button>
                
                <a asp-page="./Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </abp-card-body>
</abp-card>