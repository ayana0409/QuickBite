@page
@model QuickBite.Identity.Web.Pages.Roles.CreateModel

<h2 class="mb-4">Create New Role</h2>

<abp-card>
    <abp-card-header>Create New Role</abp-card-header>
    <abp-card-body>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <abp-input asp-for="Input.Name" />

            <!-- Checkbox IsDefault -->
            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox" 
                           class="form-check-input" 
                           asp-for="Input.IsDefault" />
                    <label class="form-check-label" asp-for="Input.IsDefault">
                        Is Default Role
                    </label>
                </div>
                <small class="text-muted">Role này sẽ được gán tự động cho người dùng mới.</small>
            </div>

            <!-- Checkbox IsPublic -->
            <div class="mb-4">
                <div class="form-check">
                    <input type="checkbox" 
                           class="form-check-input" 
                           asp-for="Input.IsPublic" />
                    <label class="form-check-label" asp-for="Input.IsPublic">
                        Is Public
                    </label>
                </div>
                <small class="text-muted">Người dùng có thể nhìn thấy role này.</small>
            </div>

            <div>
                <abp-button button-type="Primary" type="submit">
                    <i class="fa fa-save"></i> Create Role
                </abp-button>
                
                <a asp-page="./Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </abp-card-body>
</abp-card>