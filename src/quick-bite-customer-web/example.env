# Microservices Backend URLs
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_IDENTITY_URL=http://localhost:44391
NEXT_PUBLIC_ORDER_URL=http://localhost:3001/orders
NEXT_PUBLIC_CATALOG_URL=http://localhost:3001/catalog
NEXT_PUBLIC_INVENTORY_URL=http://localhost:3001/inventory
NEXT_PUBLIC_PAYMENT_URL=http://localhost:3001/payment
NEXT_PUBLIC_MERCHANT_URL=http://localhost:5173/merchant

# NextAuth / OIDC Configuration
NEXTAUTH_SECRET=your-32-char-random-secret-key
NEXTAUTH_URL=http://localhost:3002
OIDC_ISSUER=http://localhost:44391
OIDC_CLIENT_ID=quickbite_web
OIDC_CLIENT_SECRET=your-oidc-client-secret

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_FOLDER=quick-bite/food-items

# System Maintenance & Operating Hours (UTC+7)
# Set NEXT_PUBLIC_IS_MAINTAIN to "true" to lock web portal in maintenance mode
NEXT_PUBLIC_IS_MAINTAIN=false
# Operating window in HH:mm (24-hour UTC+7 format). Leave blank for 24/7 operation.
NEXT_PUBLIC_STARTUP=08:00
NEXT_PUBLIC_SHUTDOWN=22:00

