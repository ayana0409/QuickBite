{
    // VS Code Launch & Compound Debug Configurations for QuickBite Microservices
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: QuickBite.Identity Debug (NetCoreDbg)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/QuickBite.Identity/src/QuickBite.Identity.Web/bin/Debug/net10.0/QuickBite.Identity.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/QuickBite.Identity/src/QuickBite.Identity.Web",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "netcoredbg",
                "pipeArgs": [
                    "--interpreter=vscode"
                ],
                "debuggerPath": "netcoredbg"
            }
        },
        {
            "name": "Debug Catalog Service (NestJS)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/src/quick-bite.catalog",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "start:debug"],
            "console": "integratedTerminal",
            "restart": true,
            "port": 9229
        },
        {
            "type": "java",
            "name": "Debug Inventory Service (Spring Boot)",
            "request": "launch",
            "mainClass": "com.quickbite.inventory.InventoryApplication",
            "projectName": "inventory",
            "cwd": "${workspaceFolder}/src/quick-bite-inventory"
        },
        {
            "type": "java",
            "name": "Attach to Inventory Service (Remote Debug 5005)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        }
    ],
    "compounds": [
        {
            "name": "🚀 Debug (Catalog + Inventory)",
            "configurations": [
                "Debug Catalog Service (NestJS)",
                "Debug Inventory Service (Spring Boot)"
            ],
            "stopAll": true
        },
        {
            "name": "🌐 Debug System (Identity + Catalog + Inventory)",
            "configurations": [
                "C#: QuickBite.Identity Debug (NetCoreDbg)",
                "Debug Catalog Service (NestJS)",
                "Debug Inventory Service (Spring Boot)"
            ],
            "stopAll": true
        }
    ]
}